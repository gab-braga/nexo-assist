{
  "name": "nexo-assist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:ui": "node tests/interface-check.mjs",
    "test:forms": "node tests/forms-check.mjs",
    "db:setup": "node --conditions=react-server --import tsx scripts/setup-database.ts",
    "auth:role": "node scripts/set-role.mjs",
    "test:backend": "node --conditions=react-server --import tsx --test tests/backend.test.ts tests/tickets.test.ts",
    "test:agent": "node --conditions=react-server --import tsx --test tests/agent.test.ts",
    "test:agent:database": "node --conditions=react-server --import tsx tests/agent-database.ts",
    "test:agent:live": "node --conditions=react-server --import tsx tests/agent-live.ts",
    "test:agent:ui": "node --conditions=react-server --import tsx tests/agent-ui.ts",
    "test:tickets:database": "node --conditions=react-server --import tsx tests/tickets-database.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed-service-desk.ts",
    "test:database": "node --conditions=react-server --import tsx tests/database-integration.ts",
    "test:integration": "node tests/interface-check.mjs --cloud"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.96",
    "@hookform/resolvers": "^6.0.2",
    "@mastra/core": "1.80.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "12.10.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^1.63.0",
    "mongodb": "^7.7.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "@firebase/app": "0.14.9",
    "@firebase/app-compat": "0.5.9"
  }
}
