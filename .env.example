# Copy to .env.local. Never commit administrative credentials.
FIREBASE_PROJECT_ID=nexo-assist
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Alternative in hosted environments: FIREBASE_SERVICE_ACCOUNT_JSON (server only)
MONGODB_DATABASE=nexo-assist-db
MONGODB_URI=mongodb://DATABASE_UID.LOCATION.firestore.goog:443/nexo-assist-db?loadBalanced=true&tls=true&retryWrites=false&authMechanism=MONGODB-OIDC
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nexo-assist.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nexo-assist
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional server-only legacy outage simulation (ISO timestamp; unset normally).
TICKET_SERVICE_UNAVAILABLE_UNTIL=
# Only needed when explicitly applying demo seed; never printed or committed.
NEXO_DEMO_PASSWORD=
# Phase 3 — server only. Set locally; never use NEXT_PUBLIC_ for model credentials.
OPENAI_API_KEY=
NEXO_AI_MODEL=gpt-5.4-mini
