# Copie para .env.local. Use um projeto de desenvolvimento/demonstração.
# Nunca publique credenciais administrativas nem as prefixe com NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=seu-projeto-firebase
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Alternativa server-only para hospedagem: JSON administrativo em UMA linha.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Sem arquivo/JSON, os SDKs podem usar Application Default Credentials.

# Firestore Enterprise com API MongoDB; UID e localização vêm do console do banco.
MONGODB_DATABASE=seu-banco
MONGODB_URI=mongodb://DATABASE_UID.LOCATION.firestore.goog:443/seu-banco?loadBalanced=true&tls=true&retryWrites=false&authMechanism=MONGODB-OIDC

# Configuração pública do aplicativo web Firebase, não a chave privada Admin.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto-firebase.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto-firebase
NEXT_PUBLIC_FIREBASE_APP_ID=

# Mastra/OpenAI: exclusivamente no servidor. Modelo ajustável sem alterar código.
OPENAI_API_KEY=
NEXO_AI_MODEL=gpt-5.4-mini

# Opcional: instante ISO futuro para simular indisponibilidade. Normalmente vazio.
TICKET_SERVICE_UNAVAILABLE_UNTIL=
# Somente para db:seed -- --apply em demo; mínimo de 12 caracteres; sem senha padrão.
NEXO_DEMO_PASSWORD=
